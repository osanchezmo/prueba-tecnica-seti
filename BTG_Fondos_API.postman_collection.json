{
	"info": {
		"_postman_id": "btg-fondos-api-collection",
		"name": "BTG Fondos API",
		"description": "Colección Postman para la API de gestión de fondos de inversión BTG Pactual.\n\n**Flujo de uso:**\n1. Crear cliente (registro)\n2. Login para obtener token JWT\n3. Usar los endpoints con el token en Authorization\n\n**IDs de fondos disponibles:** 1, 2, 3, 4, 5",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080"
		},
		{
			"key": "token",
			"value": ""
		},
		{
			"key": "clienteId",
			"value": ""
		}
	],
	"item": [
		{
			"name": "Autenticación",
			"item": [
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.success && jsonData.data && jsonData.data.token) {",
									"        pm.collectionVariables.set('token', jsonData.data.token);",
									"        pm.collectionVariables.set('clienteId', jsonData.data.clienteId || '');",
									"        console.log('Token guardado correctamente');",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"juan@test.com\",\n    \"password\": \"123456\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"login"
							]
						},
						"description": "Autentica con email y contraseña. Retorna JWT que se guarda automáticamente para las siguientes peticiones."
					}
				}
			]
		},
		{
			"name": "Clientes",
			"item": [
				{
					"name": "Crear cliente",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.success && jsonData.data && jsonData.data.id) {",
									"        pm.collectionVariables.set('clienteId', jsonData.data.id);",
									"        console.log('Cliente ID guardado: ' + jsonData.data.id);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"nombre\": \"Juan Pérez\",\n    \"email\": \"juan@test.com\",\n    \"telefono\": \"3001234567\",\n    \"password\": \"123456\",\n    \"preferenciaNotificacion\": \"EMAIL\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/clientes/",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"clientes",
								""
							]
						},
						"description": "Registra un nuevo cliente con saldo inicial de $500.000 COP. Endpoint público.\n\nPreferenciaNotificacion: EMAIL o SMS"
					}
				},
				{
					"name": "Obtener historial de transacciones",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/clientes/{{clienteId}}/transacciones",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"clientes",
								"{{clienteId}}",
								"transacciones"
							]
						},
						"description": "Obtiene el historial de transacciones (aperturas y cancelaciones) de un cliente. Requiere autenticación."
					}
				}
			]
		},
		{
			"name": "Fondos",
			"item": [
				{
					"name": "Suscribirse a fondo",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"clienteId\": \"{{clienteId}}\",\n    \"fondoId\": \"1\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/fondos/suscribir",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"fondos",
								"suscribir"
							]
						},
						"description": "Suscribe a un cliente a un fondo de inversión. Requiere autenticación.\n\n**IDs de fondos:**\n- 1: FPV_BTG_PACTUAL_RECAUDADORA COP $75.000\n- 2: FPV_BTG_PACTUAL_ECOPETROL COP $125.000\n- 3: DEUDAPRIVADA COP $50.000\n- 4: FDO-ACCIONES COP $250.000\n- 5: FPV_BTG_PACTUAL_DINAMICA COP $100.000"
					}
				},
				{
					"name": "Cancelar suscripción",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"clienteId\": \"{{clienteId}}\",\n    \"fondoId\": \"1\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/fondos/cancelar",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"fondos",
								"cancelar"
							]
						},
						"description": "Cancela la suscripción a un fondo y devuelve el monto al cliente. Requiere autenticación."
					}
				}
			]
		},
		{
			"name": "Flujo completo (Runner)",
			"item": [
				{
					"name": "1. Crear cliente",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.success && jsonData.data && jsonData.data.id) {",
									"        pm.collectionVariables.set('clienteId', jsonData.data.id);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"nombre\": \"Juan Pérez\",\n    \"email\": \"juan@test.com\",\n    \"telefono\": \"3001234567\",\n    \"password\": \"123456\",\n    \"preferenciaNotificacion\": \"EMAIL\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/clientes/",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"clientes",
								""
							]
						}
					}
				},
				{
					"name": "2. Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.success && jsonData.data && jsonData.data.token) {",
									"        pm.collectionVariables.set('token', jsonData.data.token);",
									"        pm.collectionVariables.set('clienteId', jsonData.data.clienteId || pm.collectionVariables.get('clienteId'));",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"juan@test.com\",\n    \"password\": \"123456\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"login"
							]
						}
					}
				},
				{
					"name": "3. Suscribir fondo",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"clienteId\": \"{{clienteId}}\",\n    \"fondoId\": \"1\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/fondos/suscribir",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"fondos",
								"suscribir"
							]
						}
					}
				},
				{
					"name": "4. Ver historial",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/clientes/{{clienteId}}/transacciones",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"clientes",
								"{{clienteId}}",
								"transacciones"
							]
						}
					}
				},
				{
					"name": "5. Cancelar suscripción",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"clienteId\": \"{{clienteId}}\",\n    \"fondoId\": \"1\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/fondos/cancelar",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"fondos",
								"cancelar"
							]
						}
					}
				}
			],
			"description": "Carpeta para ejecutar el flujo completo con Collection Runner (Run → Run collection)"
		}
	]
}
